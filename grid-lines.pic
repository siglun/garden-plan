for y = 0 to 100 by 1  do {
 if ((y % 10) == 0 ) then {
    line color "blue" from (0,y*0.1) to (10,y*0.1)
 } else {
   line color "lightblue" from (0,y*0.1) to (10,y*0.1)
 }
}

for x = 0 to 100 do {
    if ((x % 10) == 0 ) then {
       line color "blue" from (x*0.1,0) to (x*0.1,10)
    } else {
       line color "lightblue" from (x*0.1,0) to (x*0.1,10)
    }
}
